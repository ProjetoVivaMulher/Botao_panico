# Porta do servidor API
PORT=3001

# Ambiente de execução
NODE_ENV=development

# Configuração de banco de dados (ainda não decidido pelo grupo — ver DECISÃO NECESSÁRIA
# em 00_CONTRATOS_E_ALINHAMENTO.md. Por enquanto, o backend usa um arquivo JSON local
# como armazenamento temporário, criado pela tarefa B2 do Matheus.)
DATABASE_URL=postgresql://usuario:senha@localhost:5432/viva_mulher

# Configuração da Central de Socorro (Exemplo de demonstração)
DEFAULT_SOCORRO_PHONE=5521999999999

# Autenticação básica do painel interno (demonstração acadêmica, não é produção real)
# Troque estes valores antes de publicar o repositório publicamente.
ADMIN_USER=admin
ADMIN_PASSWORD=troque-esta-senha
