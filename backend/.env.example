# Porta do servidor API
PORT=3001

# Ambiente de execução
NODE_ENV=development

# Configuração de banco de dados (ainda não decidido pelo grupo — ver DECISÃO NECESSÁRIA
# em 00_CONTRATOS_E_ALINHAMENTO.md. Por enquanto, o backend usa um arquivo JSON local
# como armazenamento temporário, criado pela tarefa B2 do Matheus.)
