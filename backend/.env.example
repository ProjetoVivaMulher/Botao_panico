# Porta do servidor API
PORT=3001

# Ambiente de execução
NODE_ENV=development

# ---- Banco de dados (libSQL/SQLite via Turso) ----
# Desenvolvimento/local: deixe as variáveis abaixo vazias.
# O backend cria automaticamente backend/data/viva_mulher.db
# (esse arquivo pode ser aberto no Letos / SQLiteStudio).
#
# Produção (Vercel serverless): preencha com as credenciais do Turso.
# Crie um banco em https://turso.tech e rode: turso db show <db> --url / turso db tokens create <db>
# TURSO_DATABASE_URL=libsql://seu-banco.turso.io
# TURSO_AUTH_TOKEN=seu-token-do-turso
#
# (Aliases aceitos: DATABASE_URL / DATABASE_AUTH_TOKEN)

# Configuração da Central de Socorro (Saquarema - CRAM Viva Mulher)
DEFAULT_SOCORRO_PHONE=552139553874

# ---- CORS (segurança) ----
# Lista de origens autorizadas, separadas por vírgula (ex.: o domínio do frontend na Vercel).
# ALLOWED_ORIGINS=https://seu-frontend.vercel.app
#
# Permitir QUALQUER subdomínio *.vercel.app? Só ative se realmente precisar (menos seguro).
ALLOW_VERCEL=0

# Autenticação básica do painel interno (demonstração acadêmica, não é produção real)
# Troque estes valores antes de publicar o repositório publicamente.
ADMIN_USER=admin
ADMIN_PASSWORD=troque-esta-senha
